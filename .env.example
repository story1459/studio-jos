# Supabase — 관리자 로그인에 씁니다.
# 이 파일을 .env.local 로 복사해서 값을 채우세요.
#
# 값 찾는 곳: supabase.com → 프로젝트 → Settings → API
#
# 주의: NEXT_PUBLIC_ 으로 시작하는 값은 빌드 결과물(브라우저)에 그대로 들어갑니다.
#       anon 키는 원래 공개되는 값이라 괜찮습니다. 데이터 보호는 Supabase 의
#       RLS(행 수준 보안) 정책이 담당합니다. service_role 키는 절대 넣지 마세요.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
